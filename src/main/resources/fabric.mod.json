{
  "schemaVersion": 1,
  "id": "${id}",
  "version": "${version}",

  "name": "${name}",
  "description": "SCT Masa extra tweaks",
  "authors": [
    "late_maple"
  ],
  "contact": {
    "sources": "https://github.com/late-maple/SCTMasaExtra"
  },
  "license": "LGPL-3.0",

  "icon": "assets/sctmasaextra/icon.png",

  "environment": "client",
  "entrypoints": {
    "client": [
      "top.sctserver.sctmasaextra.SCTMasaExtraMod"
    ],
    "modmenu": [
      "top.sctserver.sctmasaextra.compat.modmenu.ModMenuApiImpl"
    ]
  },
  "mixins": [
    "sctmasaextra.mixins.json"
  ],

  "depends": {
    "fabricloader": ">=0.11.4",
    "minecraft": "${minecraft_dependency}",
    "malilib": "${malilib_dependency}",
    "tweakeroo": "${tweakeroo_dependency}",
    "litematica": "${litematica_dependency}",
    "mixinextras": ">=0.3.0"
  }
}
